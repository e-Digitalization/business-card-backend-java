# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Spring Boot loads this file automatically (spring-dotenv).
# Never commit .env — it is gitignored.

# --- Database (optional overrides) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/business_card
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# --- JWT ---
# APP_JWT_SECRET=ChangeThisSecretInProduction-UseAtLeast32Chars

# --- Google OAuth (must match frontend VITE_GOOGLE_CLIENT_ID) ---
# GOOGLE_CLIENT_ID=

# --- AI card scan (set ONE of these) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- AI scan freemium ---
SCAN_FREE_LIMIT=2
FRONTEND_BASE_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080

# --- Selcom checkout (leave empty to use local demo payment) ---
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
SELCOM_AMOUNT_TZS=10000
SELCOM_CURRENCY=TZS
# Set true to force demo checkout even if keys are present
SELCOM_MOCK=false

# Physical NFC card (active product)
NFC_CARD_PRICE_TZS=100000
